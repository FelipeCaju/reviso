{
  "name": "AppointmentHistory",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "appointment_id": {
      "type": "string",
      "title": "Agendamento"
    },
    "previous_date": {
      "type": "string",
      "format": "date",
      "title": "Data Anterior"
    },
    "new_date": {
      "type": "string",
      "format": "date",
      "title": "Nova Data"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Quando"
    },
    "changed_by": {
      "type": "string",
      "title": "Usu\u00e1rio"
    },
    "reason": {
      "type": "string",
      "title": "Motivo"
    }
  },
  "required": [
    "appointment_id",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
