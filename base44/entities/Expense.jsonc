{
  "name": "Expense",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "supplier_id": {
      "type": "string",
      "title": "Fornecedor"
    },
    "beneficiary": {
      "type": "string",
      "title": "Benefici\u00e1rio"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "title": "Valor"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Vencimento"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Pagamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "vencido",
        "cancelado"
      ],
      "default": "pendente",
      "title": "Status"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "cartao_debito",
        "cartao_credito",
        "outro"
      ],
      "title": "Forma de Pagamento"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "fixa",
        "eventual"
      ],
      "default": "eventual",
      "title": "Tipo"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "title": "Recorrente"
    },
    "recurrence_period": {
      "type": "string",
      "enum": [
        "mensal",
        "semanal",
        "anual"
      ],
      "default": "mensal",
      "title": "Periodicidade"
    },
    "recurrence_day": {
      "type": "number",
      "default": 1,
      "title": "Dia de Vencimento"
    },
    "recurrence_start": {
      "type": "string",
      "format": "date",
      "title": "In\u00edcio da Recorr\u00eancia"
    },
    "recurrence_end": {
      "type": "string",
      "format": "date",
      "title": "Fim da Recorr\u00eancia"
    },
    "parent_expense_id": {
      "type": "string",
      "title": "Despesa Recorrente (origem)"
    },
    "purchase_order_id": {
      "type": "string",
      "title": "Pedido de Compra (origem)"
    },
    "attachment_url": {
      "type": "string",
      "title": "Comprovante"
    },
    "month_key": {
      "type": "string",
      "title": "M\u00eas de Refer\u00eancia (YYYY-MM)"
    }
  },
  "required": [
    "description",
    "amount",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
