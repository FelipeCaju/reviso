{
  "name": "FiscalCredential",
  "type": "object",
  "properties": {
    "workshop_id": { "type": "string", "minLength": 1, "title": "Oficina" },
    "provider": { "type": "string", "title": "Provedor" },
    "credential_type": { "type": "string", "title": "Tipo de Credencial" },
    "credential_reference": { "type": "string", "title": "Referência Segura" },
    "certificate_expiration": { "type": "string", "format": "date-time", "title": "Validade do Certificado" },
    "status": { "type": "string", "enum": ["nao_configurada", "ativa", "expirada", "erro", "revogada"], "default": "nao_configurada", "title": "Status" },
    "last_validated_at": { "type": "string", "format": "date-time", "title": "Última Validação" }
  },
  "required": ["workshop_id", "provider", "credential_type"],
  "rls": {
    "read": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] },
    "update": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] },
    "delete": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] }
  }
}
