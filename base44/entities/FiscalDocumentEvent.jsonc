{
  "name": "FiscalDocumentEvent",
  "type": "object",
  "properties": {
    "workshop_id": { "type": "string", "minLength": 1, "title": "Oficina" },
    "fiscal_document_id": { "type": "string", "title": "Documento Fiscal" },
    "event_type": { "type": "string", "enum": ["CREATED", "VALIDATION_ERROR", "SENT", "PROCESSING", "AUTHORIZED", "REJECTED", "CANCELED", "REPLACED", "RETRY", "QUERY", "ERROR"], "title": "Tipo do Evento" },
    "status": { "type": "string", "title": "Status" },
    "provider": { "type": "string", "title": "Provedor" },
    "request_id": { "type": "string", "title": "ID da Requisição" },
    "protocol": { "type": "string", "title": "Protocolo" },
    "error_code": { "type": "string", "title": "Código do Erro" },
    "error_message": { "type": "string", "title": "Mensagem do Erro" },
    "created_by": { "type": "string", "title": "Criado por" }
  },
  "required": ["workshop_id", "fiscal_document_id", "event_type"],
  "rls": {
    "read": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] },
    "update": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] },
    "delete": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] }
  }
}
