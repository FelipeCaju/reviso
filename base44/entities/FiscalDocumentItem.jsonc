{
  "name": "FiscalDocumentItem",
  "type": "object",
  "properties": {
    "workshop_id": { "type": "string", "minLength": 1, "title": "Oficina" },
    "fiscal_document_id": { "type": "string", "title": "Documento Fiscal" },
    "source_item_type": { "type": "string", "enum": ["WORK_ORDER_ITEM"], "title": "Tipo do Item de Origem" },
    "source_item_id": { "type": "string", "title": "Item de Origem" },
    "item_type": { "type": "string", "enum": ["SERVICE", "PRODUCT", "OTHER"], "title": "Tipo do Item" },
    "description": { "type": "string", "title": "Descrição" },
    "quantity": { "type": "number", "title": "Quantidade" },
    "unit": { "type": "string", "title": "Unidade" },
    "unit_price": { "type": "number", "title": "Valor Unitário" },
    "discount": { "type": "number", "default": 0, "title": "Desconto" },
    "total": { "type": "number", "title": "Total" },
    "service_fiscal_snapshot": { "type": "object", "title": "Snapshot Fiscal do Serviço" },
    "product_fiscal_snapshot": { "type": "object", "title": "Snapshot Fiscal do Produto" },
    "tax_snapshot": { "type": "object", "title": "Snapshot de Tributos" }
  },
  "required": ["workshop_id", "fiscal_document_id", "item_type", "description"],
  "rls": {
    "read": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] },
    "update": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] },
    "delete": { "$and": [{ "data.workshop_id": "{{user.data.workshop_id}}" }, { "user_condition": { "email": "__server_only__" } }] }
  }
}
