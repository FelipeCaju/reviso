{
  "name": "Material",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "title": "C\u00f3digo Interno"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "brand": {
      "type": "string",
      "title": "Marca"
    },
    "unit": {
      "type": "string",
      "default": "un",
      "title": "Unidade"
    },
    "cost": {
      "type": "number",
      "default": 0,
      "title": "Custo"
    },
    "sale_price": {
      "type": "number",
      "default": 0,
      "title": "Pre\u00e7o de Venda"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "title": "Estoque"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    }
  },
  "required": [
    "description",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
