{
  "name": "Payment",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "work_order_id": {
      "type": "string",
      "title": "Ordem de Servi\u00e7o"
    },
    "customer_id": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_name_snapshot": {
      "type": "string",
      "title": "Cliente (snapshot)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "title": "Valor"
    },
    "method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "cartao_debito",
        "cartao_credito",
        "outro"
      ],
      "default": "dinheiro",
      "title": "Forma de Pagamento"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "title": "Data do Pagamento"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "registered_by": {
      "type": "string",
      "title": "Usu\u00e1rio que Registrou"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "cancelado"
      ],
      "default": "ativo",
      "title": "Status"
    },
    "cancel_reason": {
      "type": "string",
      "title": "Motivo do Cancelamento"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "title": "Cancelado em"
    },
    "cancelled_by": {
      "type": "string",
      "title": "Cancelado por"
    }
  },
  "required": [
    "work_order_id",
    "amount",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
