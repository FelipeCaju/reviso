{
  "name": "PurchaseOrderItem",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "order_id": {
      "type": "string",
      "title": "Pedido"
    },
    "material_id": {
      "type": "string",
      "title": "Material"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "Quantidade"
    },
    "unit": {
      "type": "string",
      "default": "un",
      "title": "Unidade"
    },
    "unit_price": {
      "type": "number",
      "default": 0,
      "title": "Valor Unit\u00e1rio"
    },
    "total": {
      "type": "number",
      "default": 0,
      "title": "Total"
    },
    "received_quantity": {
      "type": "number",
      "default": 0,
      "title": "Qtd Recebida"
    },
    "received": {
      "type": "boolean",
      "default": false,
      "title": "Recebido"
    }
  },
  "required": [
    "order_id",
    "description",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
