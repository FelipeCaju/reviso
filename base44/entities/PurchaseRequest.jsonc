{
  "name": "PurchaseRequest",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "number": {
      "type": "string",
      "title": "N\u00famero"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "responsible": {
      "type": "string",
      "title": "Respons\u00e1vel"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "cotacao",
        "aguardando_resposta",
        "aprovado",
        "pedido_realizado",
        "parcialmente_recebido",
        "recebido",
        "cancelado"
      ],
      "default": "rascunho",
      "title": "Status"
    },
    "supplier_ids": {
      "type": "array",
      "title": "Fornecedores Selecionados",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "number",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "user_condition": { "data.workshop_id": { "$nin": ["", null] } } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
