{
  "name": "Service",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "title": "C\u00f3digo"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "default_price": {
      "type": "number",
      "default": 0,
      "title": "Valor Padr\u00e3o"
    },
    "estimated_time": {
      "type": "string",
      "title": "Tempo Estimado"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    }
  },
  "required": [
    "description",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
