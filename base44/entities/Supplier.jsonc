{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "title": "Nome / Raz\u00e3o Social"
    },
    "person_type": {
      "type": "string",
      "enum": ["PF", "PJ", "EXTERIOR"],
      "title": "Tipo de Pessoa"
    },
    "razao_social": {
      "type": "string",
      "title": "Raz\u00e3o Social"
    },
    "fantasy_name": {
      "type": "string",
      "title": "Nome Fantasia"
    },
    "cpf_cnpj": {
      "type": "string",
      "title": "CPF/CNPJ"
    },
    "inscricao_estadual": {
      "type": "string",
      "title": "Inscri\u00e7\u00e3o Estadual"
    },
    "inscricao_municipal": {
      "type": "string",
      "title": "Inscri\u00e7\u00e3o Municipal"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "cep": {
      "type": "string",
      "title": "CEP"
    },
    "address": {
      "type": "string",
      "title": "Endere\u00e7o"
    },
    "number": {
      "type": "string",
      "title": "N\u00famero"
    },
    "complement": {
      "type": "string",
      "title": "Complemento"
    },
    "neighborhood": {
      "type": "string",
      "title": "Bairro"
    },
    "city": {
      "type": "string",
      "title": "Cidade"
    },
    "state": {
      "type": "string",
      "title": "Estado"
    },
    "city_ibge_code": {
      "type": "string",
      "title": "C\u00f3digo IBGE do Munic\u00edpio"
    },
    "country": {
      "type": "string",
      "default": "Brasil",
      "title": "Pa\u00eds"
    },
    "country_code": {
      "type": "string",
      "default": "1058",
      "title": "C\u00f3digo do Pa\u00eds"
    },
    "contact_name": {
      "type": "string",
      "title": "Nome do Contato"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    }
  },
  "required": [
    "name",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
