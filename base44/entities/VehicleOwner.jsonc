{
  "name": "VehicleOwner",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Ve\u00edculo"
    },
    "customer_id": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_name_snapshot": {
      "type": "string",
      "title": "Nome do Propriet\u00e1rio (snapshot)"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "title": "In\u00edcio"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "title": "Fim"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    }
  },
  "required": [
    "vehicle_id",
    "customer_id"
  ],
  "rls": {
    "read": {
      "data.workshop_id": "{{user.data.workshop_id}}"
    },
    "create": {
      "data.workshop_id": "{{user.data.workshop_id}}"
    },
    "update": {
      "data.workshop_id": "{{user.data.workshop_id}}"
    },
    "delete": {
      "data.workshop_id": "{{user.data.workshop_id}}"
    }
  }
}