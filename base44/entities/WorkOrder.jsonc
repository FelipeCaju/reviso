{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina"
    },
    "number": {
      "type": "string",
      "title": "N\u00famero"
    },
    "customer_id": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_name_snapshot": {
      "type": "string",
      "title": "Cliente (snapshot)"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Ve\u00edculo"
    },
    "plate_snapshot": {
      "type": "string",
      "title": "Placa (snapshot)"
    },
    "vehicle_description_snapshot": {
      "type": "string",
      "title": "Ve\u00edculo (snapshot)"
    },
    "mileage_in": {
      "type": "number",
      "default": 0,
      "title": "Km Entrada"
    },
    "entry_date": {
      "type": "string",
      "format": "date-time",
      "title": "Entrada"
    },
    "expected_delivery": {
      "type": "string",
      "format": "date",
      "title": "Previs\u00e3o Entrega"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time",
      "title": "Conclus\u00e3o"
    },
    "customer_report": {
      "type": "string",
      "title": "Relato"
    },
    "diagnosis": {
      "type": "string",
      "title": "Diagn\u00f3stico"
    },
    "mechanic_id": {
      "type": "string",
      "title": "Mec\u00e2nico Respons\u00e1vel"
    },
    "internal_notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es Internas"
    },
    "customer_notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es Cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "aguardando_pecas",
        "em_execucao",
        "finalizada",
        "cancelada"
      ],
      "default": "aberta",
      "title": "Status"
    },
    "cancel_reason": {
      "type": "string",
      "title": "Motivo do Cancelamento"
    },
    "subtotal_parts": {
      "type": "number",
      "default": 0,
      "title": "Subtotal Pe\u00e7as"
    },
    "subtotal_labor": {
      "type": "number",
      "default": 0,
      "title": "Subtotal M\u00e3o de Obra"
    },
    "socorro": {
      "type": "number",
      "default": 0,
      "title": "Socorro"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "title": "Desconto"
    },
    "total": {
      "type": "number",
      "default": 0,
      "title": "Total"
    },
    "quote_id": {
      "type": "string",
      "title": "Or\u00e7amento de Origem"
    },
    "appointment_id": {
      "type": "string",
      "title": "Agendamento de Origem"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Fotos Anexadas"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "nao_pago",
        "parcialmente_pago",
        "pago",
        "isento_cancelado"
      ],
      "default": "nao_pago",
      "title": "Status de Pagamento"
    },
    "paid_amount": {
      "type": "number",
      "default": 0,
      "title": "Valor Pago"
    },
    "customer_notified": {
      "type": "boolean",
      "default": false,
      "title": "Cliente Notificado"
    },
    "notified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Notificado em"
    },
    "notified_channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "telefone",
        "email",
        "presencial",
        "outro"
      ],
      "title": "Canal da Notifica\u00e7\u00e3o"
    },
    "notified_by": {
      "type": "string",
      "title": "Notificado por"
    }
  },
  "required": [
    "number"
  ],
  "rls": {
    "read": {
      "data.workshop_id": "{{user.data.workshop_id}}"
    },
    "create": {
      "data.workshop_id": "{{user.data.workshop_id}}"
    },
    "update": {
      "data.workshop_id": "{{user.data.workshop_id}}"
    },
    "delete": {
      "data.workshop_id": "{{user.data.workshop_id}}"
    }
  }
}