{
  "name": "WorkOrderItem",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "title": "Oficina",
      "minLength": 1
    },
    "work_order_id": {
      "type": "string",
      "title": "OS"
    },
    "type": {
      "type": "string",
      "enum": [
        "material",
        "servico"
      ],
      "title": "Tipo"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "Quantidade"
    },
    "unit": {
      "type": "string",
      "default": "un",
      "title": "Unidade"
    },
    "fiscal_treatment": {
      "type": "string",
      "enum": ["automatico", "incluir", "excluir"],
      "default": "automatico",
      "title": "Tratamento Fiscal"
    },
    "unit_price": {
      "type": "number",
      "default": 0,
      "title": "Valor Unit\u00e1rio"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "title": "Desconto"
    },
    "total": {
      "type": "number",
      "default": 0,
      "title": "Total"
    },
    "material_id": {
      "type": "string",
      "title": "Material (origem)"
    },
    "service_id": {
      "type": "string",
      "title": "Servi\u00e7o (origem)"
    },
    "added_after_approval": {
      "type": "boolean",
      "default": false,
      "title": "Adicionado Ap\u00f3s Aprova\u00e7\u00e3o"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "aprovado",
        "aguardando",
        "recusado"
      ],
      "default": "aprovado",
      "title": "Status de Aprova\u00e7\u00e3o"
    }
  },
  "required": [
    "work_order_id",
    "type",
    "description",
    "workshop_id"
  ],
  "rls": {
    "read": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "create": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "update": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] },
    "delete": { "$and": [
      { "data.workshop_id": { "$nin": ["", null] } },
      { "data.workshop_id": "{{user.data.workshop_id}}" }
    ] }
  }
}
