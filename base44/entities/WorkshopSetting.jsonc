{
  "name": "WorkshopSetting",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome da Oficina"
    },
    "razao_social": {
      "type": "string",
      "title": "Raz\u00e3o Social"
    },
    "cnpj": {
      "type": "string",
      "title": "CNPJ"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "address": {
      "type": "string",
      "title": "Endere\u00e7o"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo"
    },
    "default_quote_text": {
      "type": "string",
      "title": "Texto Padr\u00e3o Or\u00e7amento"
    },
    "default_validity_days": {
      "type": "number",
      "default": 15,
      "title": "Validade Padr\u00e3o (dias)"
    },
    "default_os_note": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o Padr\u00e3o OS"
    },
    "default_capacity": {
      "type": "number",
      "default": 8,
      "title": "Capacidade Padr\u00e3o"
    },
    "capacity_monday": {
      "type": "number",
      "default": 8,
      "title": "Capacidade Segunda"
    },
    "capacity_tuesday": {
      "type": "number",
      "default": 8,
      "title": "Capacidade Ter\u00e7a"
    },
    "capacity_wednesday": {
      "type": "number",
      "default": 8,
      "title": "Capacidade Quarta"
    },
    "capacity_thursday": {
      "type": "number",
      "default": 8,
      "title": "Capacidade Quinta"
    },
    "capacity_friday": {
      "type": "number",
      "default": 6,
      "title": "Capacidade Sexta"
    },
    "capacity_saturday": {
      "type": "number",
      "default": 3,
      "title": "Capacidade S\u00e1bado"
    },
    "capacity_sunday": {
      "type": "number",
      "default": 0,
      "title": "Capacidade Domingo"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "title": "Oficina de Demonstra\u00e7\u00e3o"
    },
    "demo_email": {
      "type": "string",
      "title": "E-mail Demo"
    },
    "demo_password": {
      "type": "string",
      "title": "Senha Demo"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "normal"
      ],
      "default": "free",
      "title": "Plano"
    },
    "plan_value": {
      "type": "number",
      "default": 0,
      "title": "Valor Mensal (R$)"
    },
    "expense_categories": {
      "type": "array",
      "title": "Categorias de Despesa",
      "items": {
        "type": "string"
      },
      "default": [
        "\u00c1gua",
        "Energia",
        "Internet",
        "Aluguel",
        "Funcion\u00e1rios",
        "Impostos",
        "Contabilidade",
        "Material de limpeza",
        "Combust\u00edvel",
        "Ferramentas",
        "Manuten\u00e7\u00e3o",
        "Alimenta\u00e7\u00e3o",
        "Compras",
        "Outros"
      ]
    }
  },
  "required": [],
  "rls": {
    "read": {
      "id": "{{user.data.workshop_id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "id": "{{user.data.workshop_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}